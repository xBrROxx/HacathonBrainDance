# Cortex credentials
CORTEX_CLIENT_ID=
CORTEX_CLIENT_SECRET=
CORTEX_URL=wss://localhost:6868

# Use LSL instead of Cortex
USE_LSL=1

# WebSocket server
EEG_WS_HOST=127.0.0.1
EEG_WS_PORT=8765

# Powerline frequency (50 Hz Europe/Asia, 60 Hz USA)
EEG_POWERLINE_HZ=50

# Model path (auto-detected if not set)
EEG_EMOTION_ARTIFACT_DIR=

# Data recording
RECORD_PREDICTIONS=1
RECORD_PREPROCESSED=1
PREDICTIONS_JSONL=

EEG_VALENCE_MODEL_PATH=
EEG_AROUSAL_MODEL_PATH=
EEG_SCALER_PATH=
